{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenariosListResponse",
  "type": "object",
  "required": [
    "catalog_sha256",
    "runner",
    "scenarios",
    "schema"
  ],
  "properties": {
    "catalog_sha256": {
      "type": "string"
    },
    "runner": {
      "$ref": "#/definitions/RunnerIdentity"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ScenarioDescriptor"
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "definitions": {
    "ArtifactExpectation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "max_size_bytes",
        "media_type",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "max_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "media_type": {
          "type": "string"
        },
        "schema": true
      }
    },
    "Capability": {
      "description": "What a scenario needs from the engine, the runner host or a fixture to run. The closed list keeps the catalog honest: a new need is a new variant, and every id is spelled once.",
      "type": "string",
      "enum": [
        "browser::interactive",
        "cross_repo_contract_simulator::v1",
        "curl",
        "docker",
        "e2e::adaptive-flow-v1",
        "e2e::control-plane-v1",
        "e2e::filesystem",
        "e2e::git",
        "e2e::run-scoped-fixtures",
        "e2e::shell",
        "e2e::subagents",
        "e2e::workflow-resume-v1",
        "fixture::multi-origin-http",
        "git",
        "git::deterministic-fixture-v1",
        "git::offline-bundle",
        "github::security-read",
        "github::trusted-handoff",
        "harness::independent_session",
        "harness::post-turn-validation",
        "harness::scripted-dialogue-v1",
        "iii::coder",
        "iii::compose",
        "iii::database",
        "iii::functions",
        "iii::registry",
        "iii::shell",
        "iii::state",
        "iii::triggers",
        "iii::workers",
        "incident_fixture::v1",
        "node",
        "playwright",
        "python3",
        "release_shadow::read-only-v1",
        "release_train_simulator::v1",
        "security_scan::on-demand",
        "security_scan::v1",
        "swe::isolated-python-workspace"
      ]
    },
    "DeliverableContract": {
      "type": "object",
      "required": [
        "artifacts",
        "capture_before_cleanup",
        "invariants",
        "provenance_required"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactExpectation"
          }
        },
        "capture_before_cleanup": {
          "type": "boolean"
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvariantSpec"
          }
        },
        "provenance_required": {
          "type": "boolean"
        }
      }
    },
    "ExecutionPolicy": {
      "type": "object",
      "required": [
        "max_turns",
        "stuck_timeout_seconds"
      ],
      "properties": {
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_total_tokens": {
          "description": "Shared Harness token budget. `None` leaves the Harness budget unbounded for this scenario.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_turns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_validation_retries": {
          "description": "Optional per-session cap for post-turn validation denials. `None` preserves the Harness-configured default.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "stuck_timeout_seconds": {
          "description": "Stop only after this many seconds without observable useful progress. Large scenarios have no fixed wall-clock deadline.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ExecutionRealism": {
      "type": "string",
      "enum": [
        "synthetic",
        "realistic_simulator",
        "frozen_real_artifact"
      ]
    },
    "HumanHorizon": {
      "type": "object",
      "properties": {
        "basis": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/HumanHorizonBasis"
            }
          ]
        },
        "max_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "min_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "HumanHorizonBasis": {
      "type": "string",
      "enum": [
        "unknown",
        "author_estimate",
        "measured"
      ]
    },
    "InvariantSpec": {
      "type": "object",
      "required": [
        "description",
        "id"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "RunnerIdentity": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScenarioCharacterization": {
      "type": "object",
      "properties": {
        "human_horizon": {
          "default": {
            "basis": "unknown"
          },
          "allOf": [
            {
              "$ref": "#/definitions/HumanHorizon"
            }
          ]
        },
        "realism": {
          "default": {
            "execution": "synthetic",
            "shadow": "none"
          },
          "allOf": [
            {
              "$ref": "#/definitions/ScenarioRealism"
            }
          ]
        }
      }
    },
    "ScenarioDescriptor": {
      "type": "object",
      "required": [
        "behavior_sha256",
        "case_id",
        "characterization",
        "contract_sha256",
        "deliverable_contract",
        "inputs_sha256",
        "required_capabilities",
        "resource_envelope",
        "scenario_id",
        "seed"
      ],
      "properties": {
        "behavior_sha256": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "characterization": {
          "$ref": "#/definitions/ScenarioCharacterization"
        },
        "contract_sha256": {
          "type": "string"
        },
        "deliverable_contract": {
          "$ref": "#/definitions/DeliverableContract"
        },
        "inputs_sha256": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          }
        },
        "resource_envelope": {
          "$ref": "#/definitions/ScenarioResourceEnvelope"
        },
        "scenario_id": {
          "$ref": "#/definitions/ScenarioId"
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ScenarioId": {
      "type": "string",
      "enum": [
        "registry_planning",
        "registry_implementation",
        "registry_environment",
        "registry_verification",
        "kanban_c1_foundation",
        "kanban_c2_persistence",
        "kanban_c3_board",
        "kanban_c4_ticket_flow",
        "kanban_c5_edit_move",
        "kanban_c6_discussion",
        "kanban_c7_live",
        "linkly_tutorial",
        "context_pressure",
        "minimal_path",
        "persistent_state",
        "insert_record",
        "sequential_pipeline",
        "database_migration_recovery",
        "shell_coder_sandbox",
        "research_pipeline",
        "fanout_ladder",
        "security_review",
        "incident_response",
        "todo_worker_simple",
        "todo_worker_planned",
        "engineering_ticket",
        "engineering_ticket_git_handoff",
        "engineering_endurance_ladder",
        "git_regression_forensics",
        "mechanical_reaction",
        "timer_wake",
        "receiving_operation",
        "validation_loop",
        "subagent_validation",
        "subagent_validation_failure",
        "validation_self_repair",
        "validation_scope_enforcement",
        "validation_chain",
        "secret_hygiene",
        "prompt_injection_resilience",
        "moving_target",
        "poison_message",
        "cleanup_under_failure",
        "depth_ladder",
        "quorum_fan_in",
        "contention_ledger",
        "wake_chain_soak",
        "chess_engine_build",
        "chess_play_ladder",
        "trend_blog",
        "trending_topics_build",
        "typescript_chat_service",
        "tool_contract_recovery",
        "policy_bound_action",
        "cross_app_transaction",
        "performance_regression",
        "browser_cross_site",
        "release_train_recovery",
        "cross_repo_contract_migration"
      ]
    },
    "ScenarioRealism": {
      "type": "object",
      "properties": {
        "execution": {
          "default": "synthetic",
          "allOf": [
            {
              "$ref": "#/definitions/ExecutionRealism"
            }
          ]
        },
        "shadow": {
          "default": "none",
          "allOf": [
            {
              "$ref": "#/definitions/ShadowMode"
            }
          ]
        }
      }
    },
    "ScenarioResourceEnvelope": {
      "type": "object",
      "required": [
        "execution"
      ],
      "properties": {
        "execution": {
          "$ref": "#/definitions/ExecutionPolicy"
        },
        "workflow": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowResourceEnvelope"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ShadowMode": {
      "type": "string",
      "enum": [
        "none",
        "read_only"
      ]
    },
    "WorkflowResourceEnvelope": {
      "type": "object",
      "required": [
        "max_nodes",
        "max_parallel",
        "step_timeout_seconds",
        "technical_retries",
        "workflow_timeout_seconds"
      ],
      "properties": {
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_nodes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_parallel": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "step_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "technical_retries": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "workflow_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
