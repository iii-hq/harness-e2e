{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinitionV1",
  "type": "object",
  "required": [
    "description",
    "id",
    "nodes",
    "scenario_version",
    "schema_version"
  ],
  "properties": {
    "criteria": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkflowCriterionDeclaration"
      }
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "limits": {
      "default": {
        "max_cost_usd": null,
        "max_nodes": 64,
        "max_parallel": 4,
        "max_total_tokens": null,
        "step_timeout_seconds": 300,
        "technical_retries": 0,
        "workflow_timeout_seconds": 1800
      },
      "allOf": [
        {
          "$ref": "#/definitions/WorkflowLimits"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkflowNodeV1"
      }
    },
    "scenario_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActivationPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "always"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "conditions",
            "policy"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BooleanCondition"
              }
            },
            "policy": {
              "type": "string",
              "enum": [
                "all"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "conditions",
            "policy"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BooleanCondition"
              }
            },
            "policy": {
              "type": "string",
              "enum": [
                "any"
              ]
            }
          }
        }
      ]
    },
    "BooleanCondition": {
      "type": "object",
      "required": [
        "equals",
        "node_id",
        "port"
      ],
      "properties": {
        "equals": {
          "type": "boolean"
        },
        "node_id": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DependencyPolicy": {
      "type": "string",
      "enum": [
        "succeeded",
        "terminal"
      ]
    },
    "PortValueKind": {
      "type": "string",
      "enum": [
        "boolean",
        "json",
        "text_utf8",
        "assessment"
      ]
    },
    "WorkflowCriterionDeclaration": {
      "type": "object",
      "required": [
        "id",
        "output_port",
        "producer_node_id",
        "weight"
      ],
      "properties": {
        "advisory": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "output_port": {
          "type": "string"
        },
        "producer_node_id": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WorkflowInputBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "value"
          ],
          "properties": {
            "kind": {
              "$ref": "#/definitions/PortValueKind"
            },
            "source": {
              "type": "string",
              "enum": [
                "literal"
              ]
            },
            "value": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "node_id",
            "port",
            "source"
          ],
          "properties": {
            "node_id": {
              "type": "string"
            },
            "port": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "output"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "WorkflowLimits": {
      "type": "object",
      "properties": {
        "max_cost_usd": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_nodes": {
          "default": 64,
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_parallel": {
          "default": 4,
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_total_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "step_timeout_seconds": {
          "default": 300,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "technical_retries": {
          "default": 0,
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "workflow_timeout_seconds": {
          "default": 1800,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WorkflowNodeV1": {
      "type": "object",
      "required": [
        "id",
        "step_type",
        "step_version"
      ],
      "properties": {
        "activation": {
          "default": {
            "policy": "always"
          },
          "allOf": [
            {
              "$ref": "#/definitions/ActivationPolicy"
            }
          ]
        },
        "config": {
          "default": null
        },
        "dependency_policy": {
          "default": "succeeded",
          "allOf": [
            {
              "$ref": "#/definitions/DependencyPolicy"
            }
          ]
        },
        "depends_on": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/WorkflowInputBinding"
          }
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "step_type": {
          "type": "string"
        },
        "step_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
