{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskRunResult",
  "type": "object",
  "required": [
    "behavior_sha256",
    "budget_passed",
    "case_fingerprint",
    "cleanup_valid",
    "coverage_complete",
    "engine_version",
    "execution_id",
    "harness_version",
    "infrastructure_valid",
    "model",
    "product_passed",
    "provider",
    "schema",
    "source",
    "status",
    "system_identity_sha256",
    "task_id",
    "task_kind",
    "task_version",
    "wall_time_ms",
    "workspace"
  ],
  "properties": {
    "behavior_sha256": {
      "type": "string"
    },
    "budget_passed": {
      "type": "boolean"
    },
    "case_fingerprint": {
      "type": "string"
    },
    "cleanup_valid": {
      "type": "boolean"
    },
    "cohort_identity_sha256": {
      "default": "",
      "type": "string"
    },
    "comparison_series": {
      "default": "",
      "type": "string"
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "engine_version": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "grounding_integrity": {
      "default": false,
      "type": "boolean"
    },
    "harness_version": {
      "type": "string"
    },
    "infrastructure_valid": {
      "type": "boolean"
    },
    "lane": {
      "default": "",
      "type": "string"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/definitions/SessionMetricsPayload"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": "string"
    },
    "product_passed": {
      "type": "boolean"
    },
    "provider": {
      "type": "string"
    },
    "release_channel": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    },
    "source": {
      "$ref": "#/definitions/SourceEvidence"
    },
    "status": {
      "$ref": "#/definitions/TaskRunStatus"
    },
    "structural_integrity": {
      "default": false,
      "type": "boolean"
    },
    "subject_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_identity_sha256": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_kind": {
      "$ref": "#/definitions/TaskKind"
    },
    "task_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "technical_failure": {
      "default": false,
      "type": "boolean"
    },
    "transcript_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier": {
      "anyOf": [
        {
          "$ref": "#/definitions/TaskVerification"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_mode": {
      "default": "development",
      "allOf": [
        {
          "$ref": "#/definitions/TaskVerifierMode"
        }
      ]
    },
    "verifier_sha256": {
      "default": "",
      "type": "string"
    },
    "wall_time_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "workspace": {
      "type": "string"
    }
  },
  "definitions": {
    "CommandResult": {
      "type": "object",
      "required": [
        "args",
        "program",
        "stderr_preview",
        "stderr_sha256",
        "stdout_preview",
        "stdout_sha256",
        "success",
        "timed_out"
      ],
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "program": {
          "type": "string"
        },
        "stderr_preview": {
          "type": "string"
        },
        "stderr_sha256": {
          "type": "string"
        },
        "stdout_preview": {
          "type": "string"
        },
        "stdout_sha256": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "SessionMetricsPayload": {
      "type": "object",
      "required": [
        "by_session",
        "complete",
        "root_session_id",
        "totals"
      ],
      "properties": {
        "by_session": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SessionUsage"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "root_session_id": {
          "type": "string"
        },
        "totals": {
          "$ref": "#/definitions/SessionUsageTotals"
        },
        "traces": {
          "default": null
        }
      }
    },
    "SessionUsage": {
      "type": "object",
      "required": [
        "depth",
        "function_call_errors",
        "function_calls",
        "session_id",
        "turns"
      ],
      "properties": {
        "cache_read_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_write_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "context": {
          "default": null
        },
        "cost_usd": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "function_call_errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "function_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "parent_session_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "session_id": {
          "type": "string"
        },
        "transient_resumes": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "turns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "validation_retries": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "wake_resumes": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "SessionUsageTotals": {
      "type": "object",
      "required": [
        "function_call_errors",
        "function_calls",
        "sessions",
        "turns"
      ],
      "properties": {
        "cache_read_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_write_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cost_usd": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "function_call_errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "function_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "reasoning_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "sessions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "transient_resumes": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "turns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "validation_retries": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "wake_resumes": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "SourceEvidence": {
      "type": "object",
      "required": [
        "kind",
        "manifest_sha256",
        "paths",
        "root",
        "subtree"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "subtree": {
          "type": "string"
        }
      }
    },
    "TaskKind": {
      "type": "string",
      "enum": [
        "code_patch",
        "feature",
        "code_review",
        "planning",
        "operational_recovery",
        "endurance"
      ]
    },
    "TaskRunStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "infrastructure_error",
        "resource_limit"
      ]
    },
    "TaskVerification": {
      "type": "object",
      "required": [
        "changed_paths",
        "checks",
        "commands",
        "passed",
        "patch_lines"
      ],
      "properties": {
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VerificationCheck"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CommandResult"
          }
        },
        "passed": {
          "type": "boolean"
        },
        "patch_lines": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "TaskVerifierMode": {
      "type": "string",
      "enum": [
        "development",
        "official"
      ]
    },
    "VerificationCheck": {
      "type": "object",
      "required": [
        "detail",
        "id",
        "passed"
      ],
      "properties": {
        "detail": {
          "type": "string"
        },
        "dimension": {
          "default": "functional",
          "allOf": [
            {
              "$ref": "#/definitions/VerificationDimension"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "VerificationDimension": {
      "type": "string",
      "enum": [
        "functional",
        "structural_integrity",
        "grounding",
        "technical_reliability"
      ]
    }
  }
}
