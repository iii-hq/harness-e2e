{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskSuiteComparison",
  "type": "object",
  "required": [
    "advisory",
    "baseline_execution_id",
    "candidate_execution_id",
    "comparable",
    "deltas",
    "reason",
    "schema"
  ],
  "properties": {
    "advisory": {
      "type": "boolean"
    },
    "baseline_execution_id": {
      "type": "string"
    },
    "candidate_execution_id": {
      "type": "string"
    },
    "comparable": {
      "type": "boolean"
    },
    "deltas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskAggregateDelta"
      }
    },
    "reason": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    }
  },
  "definitions": {
    "RateDelta": {
      "description": "Difference between two rates, carrying the uncertainty both sides already measured. A cohort reports a Wilson interval per arm; collapsing the comparison to a bare point discards exactly the information that decides whether the change is real, so the interval travels with the difference.",
      "type": "object",
      "required": [
        "ci95_lower",
        "ci95_upper",
        "difference",
        "separated"
      ],
      "properties": {
        "ci95_lower": {
          "type": "number",
          "format": "double"
        },
        "ci95_upper": {
          "type": "number",
          "format": "double"
        },
        "difference": {
          "type": "number",
          "format": "double"
        },
        "separated": {
          "description": "The interval excludes zero, so the two arms are distinguishable at 95%. False means \"not separable at this sample size\", never \"equivalent\".",
          "type": "boolean"
        }
      }
    },
    "TaskAggregateDelta": {
      "type": "object",
      "required": [
        "baseline_maturity",
        "candidate_maturity",
        "task_id"
      ],
      "properties": {
        "baseline_maturity": {
          "type": "string"
        },
        "candidate_maturity": {
          "type": "string"
        },
        "grounding_integrity_rate": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "p50_billable_tokens_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_cost_usd_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_function_calls_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_total_tokens_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_turns_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_wall_time_ratio": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "product_success_rate": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "structural_integrity_rate": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "type": "string"
        },
        "technical_failure_rate": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateDelta"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
