{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FaultPlan",
  "type": "object",
  "required": [
    "actions",
    "expected_outcome",
    "profile_id",
    "profile_sha256",
    "seed"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FaultAction"
      }
    },
    "expected_outcome": {
      "$ref": "#/definitions/ExpectedTerminalOutcome"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_sha256": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ExpectedTerminalOutcome": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovered",
            "cancelled"
          ]
        },
        {
          "description": "The subject is expected to finish WITHOUT a correct deliverable: a hard-gate-failed but structurally clean, fully cleaned-up, bounded run. A wrong-but-structural result is the expectation, so it classifies as `correct_recovery`; a passed deliverable means the perturbation failed to bite and is a benchmark infrastructure failure. Degraded profiles must not declare a cancellation rule and require canonical results.",
          "type": "string",
          "enum": [
            "degraded"
          ]
        }
      ]
    },
    "FaultAction": {
      "type": "object",
      "required": [
        "action_id",
        "kind",
        "sequence",
        "target"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/FaultActionKind"
        },
        "sequence": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "target": {
          "type": "string"
        },
        "trigger_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "FaultActionKind": {
      "type": "string",
      "enum": [
        "delay_call",
        "fail_first_attempt",
        "malformed_result",
        "throttle_burst",
        "duplicate_event",
        "child_timeout",
        "transient_disconnect",
        "out_of_order_result",
        "cancel_execution"
      ]
    }
  }
}
