{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskSuiteDefinition",
  "type": "object",
  "required": [
    "id",
    "lane",
    "repetitions",
    "schema",
    "tasks",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "official_verifier_required": {
      "default": false,
      "type": "boolean"
    },
    "release_channel": {
      "type": [
        "string",
        "null"
      ]
    },
    "repetitions": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "schema": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
