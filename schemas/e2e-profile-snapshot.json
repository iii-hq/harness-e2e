{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Suite": {
      "additionalProperties": false,
      "description": "What a campaign tests: its scenarios and how often. Where it runs (the stack) and with whom (model, agent profile) are named per execution.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "lane": {
          "default": "",
          "description": "Internal: the admission budget, always `local-<id>`.",
          "type": "string"
        },
        "metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purpose": {
          "default": "",
          "type": "string"
        },
        "repetitions": {
          "default": 1,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scenario_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "scenarios": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "technical_retries": {
          "default": 0,
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "budget": true,
    "campaigns": {
      "items": true,
      "type": "array"
    },
    "cases": {
      "items": true,
      "type": "array"
    },
    "definition_sha256": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "profile": {
      "$ref": "#/definitions/Suite"
    },
    "profile_sha256": {
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "budget",
    "campaigns",
    "cases",
    "definition_sha256",
    "interpretation",
    "plan_id",
    "profile",
    "profile_sha256",
    "scenario_ids",
    "schema"
  ],
  "title": "ProfileSnapshot",
  "type": "object"
}
