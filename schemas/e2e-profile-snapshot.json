{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purpose": {
          "type": "string"
        },
        "repetitions": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scenario_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "scenarios": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "technical_retries": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "lane",
        "metrics",
        "modules",
        "purpose",
        "repetitions",
        "scenarios",
        "technical_retries"
      ],
      "type": "object"
    }
  },
  "properties": {
    "budget": true,
    "campaigns": {
      "items": true,
      "type": "array"
    },
    "cases": {
      "items": true,
      "type": "array"
    },
    "definition_sha256": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "profile": {
      "$ref": "#/definitions/Profile"
    },
    "profile_sha256": {
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "budget",
    "campaigns",
    "cases",
    "definition_sha256",
    "interpretation",
    "plan_id",
    "profile",
    "profile_sha256",
    "scenario_ids",
    "schema"
  ],
  "title": "ProfileSnapshot",
  "type": "object"
}
