{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Impact": {
      "description": "What a suite selecting by tag asked for and what it found among the scheduled tests.",
      "properties": {
        "excluded": {
          "description": "Tests carrying a requested tag that a selection by tag leaves out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "matched": {
          "description": "Scheduled tests carrying a requested tag, run on top of `pr`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requested": {
          "$ref": "#/definitions/TagSet"
        },
        "uncovered": {
          "description": "Requested tags no selected test carries, each with why: nothing in this suite protects them.",
          "items": {
            "$ref": "#/definitions/UncoveredTag"
          },
          "type": "array"
        }
      },
      "required": [
        "matched",
        "requested"
      ],
      "type": "object"
    },
    "Suite": {
      "additionalProperties": false,
      "description": "What a campaign tests: its scenarios and how often. Where it runs (the stack) and with whom (model, agent profile) are named per execution.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "lane": {
          "default": "",
          "description": "Internal: the admission budget, always `local-<id>`.",
          "type": "string"
        },
        "metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purpose": {
          "default": "",
          "type": "string"
        },
        "repetitions": {
          "default": 1,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scenario_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "scenarios": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "technical_retries": {
          "default": 0,
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "TagSet": {
      "description": "Tag names by dimension, as a dispatch states them.",
      "properties": {
        "areas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "disciplines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "UncoveredTag": {
      "properties": {
        "dimension": {
          "description": "`worker`, `area` or `discipline`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "name",
        "reason"
      ],
      "type": "object"
    }
  },
  "properties": {
    "budget": true,
    "campaigns": {
      "items": true,
      "type": "array"
    },
    "cases": {
      "items": true,
      "type": "array"
    },
    "definition_sha256": {
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/definitions/Impact"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present when the suite selects by tag."
    },
    "interpretation": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "profile": {
      "$ref": "#/definitions/Suite"
    },
    "profile_sha256": {
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "budget",
    "campaigns",
    "cases",
    "definition_sha256",
    "interpretation",
    "plan_id",
    "profile",
    "profile_sha256",
    "scenario_ids",
    "schema"
  ],
  "title": "ProfileSnapshot",
  "type": "object"
}
