{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowCheckpointV1",
  "type": "object",
  "required": [
    "active_nodes",
    "attempt_id",
    "run_id",
    "schema_version",
    "steps",
    "terminal_nodes",
    "updated_at",
    "workflow_id",
    "workflow_sha256"
  ],
  "properties": {
    "active_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt_id": {
      "type": "string"
    },
    "flow_snapshot": {
      "description": "Evidence-only projection generated by Rust. It is never accepted as runner input.",
      "default": null
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkflowStepReport"
      }
    },
    "terminal_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "workflow_sha256": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActivationPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "always"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "conditions",
            "policy"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BooleanCondition"
              }
            },
            "policy": {
              "type": "string",
              "enum": [
                "all"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "conditions",
            "policy"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BooleanCondition"
              }
            },
            "policy": {
              "type": "string",
              "enum": [
                "any"
              ]
            }
          }
        }
      ]
    },
    "ArtifactReference": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "media_type",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "BooleanCondition": {
      "type": "object",
      "required": [
        "equals",
        "node_id",
        "port"
      ],
      "properties": {
        "equals": {
          "type": "boolean"
        },
        "node_id": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DependencyPolicy": {
      "type": "string",
      "enum": [
        "succeeded",
        "terminal"
      ]
    },
    "PortValueKind": {
      "type": "string",
      "enum": [
        "boolean",
        "json",
        "text_utf8",
        "assessment"
      ]
    },
    "RedactionReport": {
      "type": "object",
      "required": [
        "redacted_fields",
        "redacted_values",
        "rules"
      ],
      "properties": {
        "redacted_fields": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "redacted_values": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "TypedPortValue": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/PortValueKind"
        },
        "value": true
      },
      "additionalProperties": false
    },
    "WorkflowAssetReport": {
      "type": "object",
      "required": [
        "artifact",
        "content_sha256",
        "id",
        "kind",
        "media_type",
        "namespaced_id",
        "preview",
        "preview_truncated",
        "size_bytes"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/definitions/ArtifactReference"
        },
        "content_sha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "namespaced_id": {
          "type": "string"
        },
        "preview": true,
        "preview_truncated": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WorkflowEvaluationOutcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "advisory",
        "not_evaluated"
      ]
    },
    "WorkflowEvaluationResult": {
      "type": "object",
      "required": [
        "id",
        "outcome",
        "summary"
      ],
      "properties": {
        "evidence_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/definitions/WorkflowEvaluationOutcome"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WorkflowFailurePhase": {
      "type": "string",
      "enum": [
        "preflight",
        "execute",
        "capture",
        "persist",
        "evaluate",
        "cleanup",
        "cancel"
      ]
    },
    "WorkflowGateResult": {
      "type": "object",
      "required": [
        "id",
        "passed",
        "reason"
      ],
      "properties": {
        "evidence_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WorkflowStepFailure": {
      "type": "object",
      "required": [
        "message",
        "phase",
        "technical"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/WorkflowFailurePhase"
        },
        "technical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "WorkflowStepReport": {
      "type": "object",
      "required": [
        "activation",
        "dependencies",
        "dependency_policy",
        "duration_ms",
        "node_id",
        "required",
        "status",
        "step_type",
        "step_version"
      ],
      "properties": {
        "activation": {
          "$ref": "#/definitions/ActivationPolicy"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowAssetReport"
          }
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependency_policy": {
          "$ref": "#/definitions/DependencyPolicy"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowEvaluationResult"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowStepFailure"
          }
        },
        "hard_gates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowGateResult"
          }
        },
        "harness_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "metrics": true,
        "node_id": {
          "type": "string"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/TypedPortValue"
          }
        },
        "redaction": {
          "default": {
            "redacted_fields": 0,
            "redacted_values": 0,
            "rules": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/RedactionReport"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/WorkflowStepStatus"
        },
        "step_type": {
          "type": "string"
        },
        "step_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "transcript": true
      },
      "additionalProperties": false
    },
    "WorkflowStepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "hard_gate_failed",
        "failed",
        "skipped",
        "cancelled"
      ]
    }
  }
}
