{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FaultProfile",
  "type": "object",
  "required": [
    "max_work_amplification",
    "profile_id",
    "seed"
  ],
  "properties": {
    "cancellation": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/CancellationRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "child_timeout_ms": {
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "delayed_calls": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/DelayRule"
      }
    },
    "duplicate_events": {
      "default": false,
      "type": "boolean"
    },
    "expected_outcome": {
      "default": "recovered",
      "allOf": [
        {
          "$ref": "#/definitions/ExpectedTerminalOutcome"
        }
      ]
    },
    "fail_first_attempt": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "malformed_results": {
      "description": "The supervisor corrupts the result payload of the first call to each named target: the subject receives undecodable, contract-breaking bytes exactly once per target.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_work_amplification": {
      "type": "number",
      "format": "double"
    },
    "out_of_order_results": {
      "default": false,
      "type": "boolean"
    },
    "profile_id": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "throttle_burst": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ThrottleRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "transient_disconnect": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/DisconnectRule"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CancellationRule": {
      "type": "object",
      "required": [
        "after_action"
      ],
      "properties": {
        "after_action": {
          "type": "string"
        },
        "grace_period_ms": {
          "default": 30000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "DelayRule": {
      "type": "object",
      "required": [
        "delay_ms",
        "target"
      ],
      "properties": {
        "delay_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "occurrences": {
          "default": 1,
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DisconnectRule": {
      "type": "object",
      "required": [
        "after_action",
        "duration_ms",
        "target"
      ],
      "properties": {
        "after_action": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExpectedTerminalOutcome": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovered",
            "cancelled"
          ]
        },
        {
          "description": "The subject is expected to finish WITHOUT a correct deliverable: a hard-gate-failed but structurally clean, fully cleaned-up, bounded run. A wrong-but-structural result is the expectation, so it classifies as `correct_recovery`; a passed deliverable means the perturbation failed to bite and is a benchmark infrastructure failure. Degraded profiles must not declare a cancellation rule and require canonical results.",
          "type": "string",
          "enum": [
            "degraded"
          ]
        }
      ]
    },
    "ThrottleRule": {
      "description": "The supervisor answers the target's next `responses` calls with a provider-throttle (429-style) rejection, spaced `spacing_ms` apart.",
      "type": "object",
      "required": [
        "responses",
        "spacing_ms",
        "target"
      ],
      "properties": {
        "responses": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "spacing_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
