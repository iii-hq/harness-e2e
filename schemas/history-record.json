{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryRecord",
  "type": "object",
  "required": [
    "archive",
    "case_count",
    "e2e_repository",
    "e2e_revision",
    "execution_id",
    "identity_sha256",
    "ingestion_id",
    "lane",
    "occurred_at",
    "passed",
    "stack_mode",
    "subject_model",
    "subject_provider",
    "subject_revision"
  ],
  "properties": {
    "archive": {
      "$ref": "#/definitions/DurableArchiveReference"
    },
    "case_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "e2e_repository": {
      "type": "string"
    },
    "e2e_revision": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "identity_sha256": {
      "type": "string"
    },
    "ingestion_id": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "stack_mode": {
      "type": "string"
    },
    "subject_model": {
      "type": "string"
    },
    "subject_provider": {
      "type": "string"
    },
    "subject_revision": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DurableArchiveReference": {
      "type": "object",
      "required": [
        "archive_id",
        "created_at",
        "execution_id",
        "identity_sha256",
        "manifest",
        "manifest_backup",
        "retention_class"
      ],
      "properties": {
        "archive_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "execution_id": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_sha256": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/definitions/StorageObjectReference"
        },
        "manifest_backup": {
          "$ref": "#/definitions/StorageObjectReference"
        },
        "retention_class": {
          "$ref": "#/definitions/RetentionClass"
        }
      },
      "additionalProperties": false
    },
    "RetentionClass": {
      "type": "string",
      "enum": [
        "temporary",
        "pull_request",
        "longitudinal",
        "canonical"
      ]
    },
    "StorageObjectReference": {
      "type": "object",
      "required": [
        "bucket",
        "key",
        "media_type",
        "sha256",
        "size_bytes",
        "uri"
      ],
      "properties": {
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "uri": {
          "type": "string"
        }
      }
    }
  }
}
