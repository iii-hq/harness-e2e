{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E2eManifest",
  "type": "object",
  "required": [
    "control_plane",
    "execution",
    "subject",
    "system_under_test"
  ],
  "properties": {
    "control_plane": {
      "$ref": "#/definitions/ControlPlaneEvidence"
    },
    "execution": {
      "$ref": "#/definitions/ExecutionIdentity"
    },
    "observation_contract": {
      "anyOf": [
        {
          "$ref": "#/definitions/ObservationRunContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "$ref": "#/definitions/ModelArtifact"
    },
    "system_under_test": {
      "$ref": "#/definitions/SystemUnderTestIdentity"
    },
    "worker_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ObservedWorkerContract"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AgentProfileArtifact": {
      "type": "object",
      "required": [
        "configuration_sha256",
        "id"
      ],
      "properties": {
        "configuration_sha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "ControlPlaneEvidence": {
      "type": "object",
      "required": [
        "functions"
      ],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionContractEvidence"
          }
        }
      }
    },
    "ExecutionIdentity": {
      "type": "object",
      "required": [
        "completed_at",
        "execution_id",
        "lane",
        "started_at"
      ],
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "execution_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      }
    },
    "FunctionContractEvidence": {
      "type": "object",
      "required": [
        "function_id",
        "request_schema",
        "response_schema",
        "sha256"
      ],
      "properties": {
        "function_id": {
          "type": "string"
        },
        "request_schema": true,
        "response_schema": true,
        "sha256": {
          "type": "string"
        }
      }
    },
    "ModelArtifact": {
      "type": "object",
      "required": [
        "context_window",
        "max_output_tokens",
        "model",
        "provider"
      ],
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentProfileArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "supports_tools": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ObservationCorrelation": {
      "type": "object",
      "required": [
        "deployment_id",
        "operation_id",
        "system"
      ],
      "properties": {
        "deployment_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "system": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ObservationDecision": {
      "type": "string",
      "enum": [
        "observe_only"
      ]
    },
    "ObservationEnvironment": {
      "type": "string",
      "enum": [
        "demonstration"
      ]
    },
    "ObservationMode": {
      "type": "object",
      "required": [
        "decision",
        "environment"
      ],
      "properties": {
        "decision": {
          "$ref": "#/definitions/ObservationDecision"
        },
        "environment": {
          "$ref": "#/definitions/ObservationEnvironment"
        }
      },
      "additionalProperties": false
    },
    "ObservationPlanIdentity": {
      "type": "object",
      "required": [
        "catalog_sha256",
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "catalog_sha256": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ObservationRunContract": {
      "type": "object",
      "required": [
        "attempt",
        "correlation",
        "mode",
        "plan",
        "runner",
        "selected_cases",
        "target"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "correlation": {
          "$ref": "#/definitions/ObservationCorrelation"
        },
        "mode": {
          "$ref": "#/definitions/ObservationMode"
        },
        "plan": {
          "$ref": "#/definitions/ObservationPlanIdentity"
        },
        "runner": {
          "$ref": "#/definitions/RunnerIdentity"
        },
        "selected_cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ObservationSelectedCase"
          }
        },
        "target": {
          "$ref": "#/definitions/ObservationTargetIdentity"
        }
      },
      "additionalProperties": false
    },
    "ObservationSelectedCase": {
      "type": "object",
      "required": [
        "behavior_sha256",
        "case_id",
        "contract_sha256",
        "inputs_sha256",
        "scenario_id",
        "seed"
      ],
      "properties": {
        "behavior_sha256": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "contract_sha256": {
          "type": "string"
        },
        "inputs_sha256": {
          "type": "string"
        },
        "scenario_id": {
          "$ref": "#/definitions/ScenarioId"
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ObservationTargetIdentity": {
      "type": "object",
      "required": [
        "application",
        "stack",
        "version"
      ],
      "properties": {
        "application": {
          "type": "string"
        },
        "stack": {
          "$ref": "#/definitions/StackIdentity"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ObservedWorkerContract": {
      "type": "object",
      "required": [
        "function_id",
        "request_schema_sha256",
        "response_schema_sha256"
      ],
      "properties": {
        "function_id": {
          "type": "string"
        },
        "request_schema_sha256": {
          "type": "string"
        },
        "response_schema_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RunnerIdentity": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScenarioId": {
      "type": "string",
      "enum": [
        "registry_planning",
        "registry_implementation",
        "registry_environment",
        "registry_verification",
        "kanban_c1_foundation",
        "kanban_c2_persistence",
        "kanban_c3_board",
        "kanban_c4_ticket_flow",
        "kanban_c5_edit_move",
        "kanban_c6_discussion",
        "kanban_c7_live",
        "linkly_tutorial",
        "context_pressure",
        "minimal_path",
        "persistent_state",
        "insert_record",
        "sequential_pipeline",
        "database_migration_recovery",
        "shell_coder_sandbox",
        "research_pipeline",
        "fanout_ladder",
        "security_review",
        "incident_response",
        "todo_worker_simple",
        "todo_worker_planned",
        "engineering_ticket",
        "engineering_ticket_git_handoff",
        "engineering_endurance_ladder",
        "git_regression_forensics",
        "mechanical_reaction",
        "timer_wake",
        "receiving_operation",
        "validation_loop",
        "subagent_validation",
        "subagent_validation_failure",
        "validation_self_repair",
        "validation_scope_enforcement",
        "validation_chain",
        "secret_hygiene",
        "prompt_injection_resilience",
        "moving_target",
        "poison_message",
        "cleanup_under_failure",
        "depth_ladder",
        "quorum_fan_in",
        "contention_ledger",
        "wake_chain_soak",
        "chess_engine_build",
        "chess_play_ladder",
        "trend_blog",
        "trending_topics_build",
        "typescript_chat_service",
        "tool_contract_recovery",
        "policy_bound_action",
        "cross_app_transaction",
        "performance_regression",
        "browser_cross_site",
        "release_train_recovery",
        "cross_repo_contract_migration"
      ]
    },
    "StackIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "workers_repository",
            "workers_revision"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "source"
              ]
            },
            "workers_repository": {
              "type": "string"
            },
            "workers_revision": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "stack_lock_digest",
            "stack_versions"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "registry"
              ]
            },
            "stack_lock_digest": {
              "type": "string"
            },
            "stack_versions": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "SystemUnderTestIdentity": {
      "type": "object",
      "required": [
        "contract_hashes",
        "e2e_repository",
        "e2e_revision",
        "engine_version",
        "harness_version",
        "stack"
      ],
      "properties": {
        "contract_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "e2e_repository": {
          "type": "string"
        },
        "e2e_revision": {
          "type": "string"
        },
        "engine_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_version": {
          "type": "string"
        },
        "harness_version": {
          "type": "string"
        },
        "stack": {
          "$ref": "#/definitions/StackIdentity"
        }
      }
    }
  }
}
