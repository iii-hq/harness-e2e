{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E2eResultsV2",
  "type": "object",
  "required": [
    "execution",
    "manifest",
    "passed",
    "scenarios",
    "schema_version",
    "subject",
    "system_under_test"
  ],
  "properties": {
    "engine_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/definitions/ExecutionIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/definitions/ModelArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge_protocol": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/definitions/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "redaction": {
      "default": {
        "policy_version": 1,
        "redacted_fields": 0,
        "redacted_values": 0,
        "rules": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/RedactionReport"
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/E2eScenarioReport"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "enum": [
        2
      ],
      "minimum": 0.0
    },
    "subject": {
      "$ref": "#/definitions/ModelArtifact"
    },
    "system_under_test": {
      "anyOf": [
        {
          "$ref": "#/definitions/SystemUnderTestIdentity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "ArtifactExpectation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "max_size_bytes",
        "media_type",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "max_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "media_type": {
          "type": "string"
        },
        "schema": true
      }
    },
    "ArtifactReference": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "media_type",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "CapturedInvariant": {
      "type": "object",
      "required": [
        "id",
        "passed",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ComplexityClassification": {
      "type": "object",
      "required": [
        "policy_version",
        "profile",
        "tier"
      ],
      "properties": {
        "policy_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "profile": {
          "$ref": "#/definitions/ComplexityProfile"
        },
        "tier": {
          "$ref": "#/definitions/ComplexityTier"
        }
      }
    },
    "ComplexityProfile": {
      "type": "object",
      "required": [
        "ambiguity_level",
        "artifact_count",
        "coordination_edges",
        "dependency_depth",
        "external_systems",
        "parallel_branches",
        "planning_depth",
        "state_transitions",
        "validation_loops",
        "wake_cycles"
      ],
      "properties": {
        "ambiguity_level": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "artifact_count": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "coordination_edges": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "dependency_depth": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "external_systems": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "parallel_branches": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "planning_depth": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "state_transitions": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "validation_loops": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "wake_cycles": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      }
    },
    "ComplexityTier": {
      "type": "string",
      "enum": [
        "l0_atomic",
        "l1_sequential",
        "l2_stateful",
        "l3_concurrent",
        "l4_coordinated",
        "l5_adaptive"
      ]
    },
    "CostReport": {
      "type": "object",
      "properties": {
        "judge_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "subject_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "CriterionReport": {
      "type": "object",
      "required": [
        "id",
        "possible",
        "reason"
      ],
      "properties": {
        "awarded": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "possible": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DeliverableContract": {
      "type": "object",
      "required": [
        "artifacts",
        "capture_before_cleanup",
        "invariants",
        "provenance_required"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactExpectation"
          }
        },
        "capture_before_cleanup": {
          "type": "boolean"
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvariantSpec"
          }
        },
        "provenance_required": {
          "type": "boolean"
        }
      }
    },
    "DeliverableReport": {
      "type": "object",
      "required": [
        "content_sha256",
        "content_size_bytes",
        "id",
        "invariants",
        "kind",
        "media_type",
        "preview",
        "provenance",
        "provenance_valid",
        "schema_valid"
      ],
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/definitions/ArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "type": "string"
        },
        "content_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CapturedInvariant"
          }
        },
        "kind": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "preview": true,
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProvenanceEvidence"
          }
        },
        "provenance_valid": {
          "type": "boolean"
        },
        "schema_valid": {
          "type": "boolean"
        }
      }
    },
    "DimensionReport": {
      "type": "object",
      "required": [
        "dimension",
        "signals"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/definitions/EvaluationDimension"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signals": true
      }
    },
    "E2eRunReport": {
      "type": "object",
      "required": [
        "cost",
        "criteria",
        "hard_gates",
        "prompt",
        "run_id",
        "session_id",
        "status",
        "wall_time_ms"
      ],
      "properties": {
        "attempt_id": {
          "default": "",
          "type": "string"
        },
        "attempt_number": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "cost": {
          "$ref": "#/definitions/CostReport"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CriterionReport"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeliverableReport"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DimensionReport"
          }
        },
        "efficiency": {
          "anyOf": [
            {
              "$ref": "#/definitions/EfficiencyReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactReference"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FailureRecord"
          }
        },
        "hard_gates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HardGateReport"
          }
        },
        "judge_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "judge_usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelUsageReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/definitions/SessionMetricsResponseBodyV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "retry_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RetryAttemptReport"
          }
        },
        "run_id": {
          "type": "string"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/RunStatus"
        },
        "transcript": true,
        "wall_time_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "E2eScenarioReport": {
      "type": "object",
      "required": [
        "aggregate",
        "case",
        "execution_policy",
        "passed",
        "runs",
        "scenario_id"
      ],
      "properties": {
        "aggregate": {
          "$ref": "#/definitions/ScenarioAggregate"
        },
        "case": {
          "anyOf": [
            {
              "$ref": "#/definitions/ScenarioCase"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "default": "",
          "type": "string"
        },
        "execution_policy": {
          "$ref": "#/definitions/ExecutionPolicy"
        },
        "passed": {
          "type": "boolean"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/E2eRunReport"
          }
        },
        "scenario_id": {
          "type": "string"
        },
        "scenario_version": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "EfficiencyReport": {
      "type": "object",
      "required": [
        "minimum_expected_work",
        "observed_complexity",
        "policy_version",
        "technical_attempts",
        "wall_time_ms"
      ],
      "properties": {
        "child_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "child_turns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "critical_path_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "effective_fan_out": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "function_call_errors": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "function_calls": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "minimum_expected_work": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "observed_complexity": {
          "$ref": "#/definitions/ObservedComplexityReport"
        },
        "observed_work": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "policy_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "root_turns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "technical_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "transient_resumes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "validation_retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "wake_resumes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "wall_time_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "work_amplification": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "EvaluationDimension": {
      "type": "string",
      "enum": [
        "deliverable",
        "structural_integrity",
        "efficiency",
        "robustness",
        "e2e_infrastructure"
      ]
    },
    "ExecutionIdentity": {
      "type": "object",
      "required": [
        "completed_at",
        "execution_id",
        "lane",
        "started_at"
      ],
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "execution_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        }
      }
    },
    "ExecutionPolicy": {
      "type": "object",
      "required": [
        "max_total_tokens",
        "max_turns",
        "stuck_timeout_seconds"
      ],
      "properties": {
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_total_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_turns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "stuck_timeout_seconds": {
          "description": "Stop only after this many seconds without observable useful progress. Large scenarios have no fixed wall-clock deadline.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "FailureDomain": {
      "type": "string",
      "enum": [
        "subject",
        "judge",
        "resource",
        "e2e_infrastructure"
      ]
    },
    "FailurePhase": {
      "type": "string",
      "enum": [
        "setup",
        "execute",
        "collect",
        "evaluate",
        "cleanup"
      ]
    },
    "FailureRecord": {
      "type": "object",
      "required": [
        "message",
        "phase"
      ],
      "properties": {
        "domain": {
          "default": "e2e_infrastructure",
          "allOf": [
            {
              "$ref": "#/definitions/FailureDomain"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/FailurePhase"
        }
      }
    },
    "HardGateReport": {
      "type": "object",
      "required": [
        "id",
        "passed",
        "reason"
      ],
      "properties": {
        "dimension": {
          "default": "structural_integrity",
          "allOf": [
            {
              "$ref": "#/definitions/EvaluationDimension"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "InvariantSpec": {
      "type": "object",
      "required": [
        "description",
        "id"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "ModelArtifact": {
      "type": "object",
      "required": [
        "context_window",
        "max_output_tokens",
        "model",
        "provider"
      ],
      "properties": {
        "context_window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "supports_tools": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ModelUsageReport": {
      "type": "object",
      "properties": {
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ObservedComplexityReport": {
      "type": "object",
      "required": [
        "policy_version"
      ],
      "properties": {
        "ambiguity_level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "artifact_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "coordination_edges": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "dependency_depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "external_systems": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "parallel_branches": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "planning_depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "policy_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "state_transitions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "validation_loops": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
