                          "text": "{\"functions\":[{\"description\":\"E2E run-scoped migration directory. Resolve an exact stale function id before selecting its replacement; returns current function ids and an opaque migration token.\",\"function_id\":\"e2etest::contract_resolver_af58\",\"request_schema\":{\"properties\":{\"legacy_function\":{\"type\":\"string\"}},\"required\":[\"legacy_function\"],\"type\":\"object\"}},{\"description\":\"E2E run-scoped profile v2 lookup. Input profile_key; output opaque profile_id, revision, and timezone required by the current scheduler contract.\",\"function_id\":\"e2etest::profile_v2_af58\",\"request_schema\":{\"properties\":{\"profile_key\":{\"type\":\"string\"}},\"required\":[\"profile_key\"],\"type\":\"object\"}},{\"description\":\"E2E run-scoped current calendar scheduler. Requires the profile id and revision, timezone, event fields, and idempotency_key equal to the migration_token returned by the resolver.\",\"function_id\":\"e2etest::calendar_schedule_v2_af58\",\"request_schema\":{\"properties\":{\"event\":{\"properties\":{\"duration_minutes\":{\"format\":\"uint32\",\"minimum\":0.0,\"type\":\"integer\"},\"starts_at_local\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"duration_minutes\",\"starts_at_local\",\"title\"],\"type\":\"object\"},\"idempotency_key\":{\"description\":\"Must exactly equal the `migration_token` returned by the resolver.\",\"type\":\"string\"},\"profile\":{\"properties\":{\"id\":{\"type\":\"string\"},\"revision\":{\"type\":\"string\"}},\"required\":[\"id\",\"revision\"],\"type\":\"object\"},\"timezone\":{\"type\":\"string\"}},\"required\":[\"event\",\"idempotency_key\",\"profile\",\"timezone\"],\"type\":\"object\"}}]}",
