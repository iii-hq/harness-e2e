{
  "kind": "engineering-endurance-case",
  "version": 1,
  "service": "append-only durable job queue",
  "language": "python",
  "production_paths": ["src/durable_queue.py"],
  "protected_paths": [
    ".harness-e2e/endurance-case.json",
    "tests/test_durable_queue.py"
