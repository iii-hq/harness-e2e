{
  "name": "@iii-hq/harness-e2e-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.console.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/chivo-mono": "^5.2.8",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "iii-browser-sdk": "^0.21.6",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
