{
  "schema_version": 1,
  "id": "security-scan.full",
  "scenario_version": 1,
  "description": "Full local security-scan lifecycle: deduplicated scan, deterministic report assessment, suggest, reconciliation, cron scheduling, list integrity, and bounded fixture cleanup.",
  "limits": {
    "max_parallel": 4,
    "max_nodes": 32,
    "step_timeout_seconds": 420,
    "workflow_timeout_seconds": 1800,
    "max_total_tokens": 500000,
    "max_cost_usd": 25.0,
    "technical_retries": 0
  },
  "nodes": [
    {
      "id": "preflight",
      "step_type": "security_scan.preflight",
      "step_version": 1,
      "config": {
        "repository": "iii-hq/security-scan-e2e-fixture",
        "scheduled_ref": "security-scan-e2e-scheduled"
      },
      "required": true
    },
    {
      "id": "request_scan_a",
      "step_type": "security_scan.request",
      "step_version": 1,
      "config": { "mode": "scan", "expect_deduplicated": false },
      "depends_on": ["preflight"],
      "inputs": {
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "preflight", "port": "commit_a" }
      },
      "required": true
    },
    {
      "id": "duplicate_scan_a",
      "step_type": "security_scan.request",
      "step_version": 1,
      "config": { "mode": "scan", "expect_deduplicated": true },
      "depends_on": ["request_scan_a"],
      "inputs": {
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "preflight", "port": "commit_a" },
        "original_run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" }
      },
      "required": true
    },
    {
      "id": "wait_scan_a",
      "step_type": "security_scan.wait",
      "step_version": 1,
      "config": { "timeout_seconds": 360, "poll_interval_ms": 500, "expected_mode": "scan" },
      "depends_on": ["request_scan_a"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" },
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "preflight", "port": "commit_a" }
      },
      "required": true
    },
    {
      "id": "assess_scan_a",
      "step_type": "security_scan.assess_report",
      "step_version": 1,
      "config": {
        "mode": "scan",
        "seeded_paths": [
          "src/vulnerable.rs",
          "package.json",
          ".env.example",
          ".github/workflows/insecure.yml"
        ]
      },
      "depends_on": ["duplicate_scan_a", "wait_scan_a"],
      "inputs": {
        "report": { "source": "output", "node_id": "wait_scan_a", "port": "report" }
      },
      "required": true
    },
    {
      "id": "request_suggest_a",
      "step_type": "security_scan.request",
      "step_version": 1,
      "config": { "mode": "suggest", "expect_deduplicated": false },
      "depends_on": ["assess_scan_a"],
      "inputs": {
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "preflight", "port": "commit_a" }
      },
      "activation": {
        "policy": "all",
        "conditions": [
          { "node_id": "assess_scan_a", "port": "findings_valid", "equals": true }
        ]
      },
      "required": false
    },
    {
      "id": "wait_suggest_a",
      "step_type": "security_scan.wait",
      "step_version": 1,
      "config": { "timeout_seconds": 360, "poll_interval_ms": 500, "expected_mode": "suggest" },
      "depends_on": ["request_suggest_a"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_suggest_a", "port": "run_id" },
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "preflight", "port": "commit_a" }
      },
      "required": false
    },
    {
      "id": "assess_suggest_a",
      "step_type": "security_scan.assess_report",
      "step_version": 1,
      "config": {
        "mode": "suggest",
        "seeded_paths": [
          "src/vulnerable.rs",
          "package.json",
          ".env.example",
          ".github/workflows/insecure.yml"
        ]
      },
      "depends_on": ["wait_suggest_a"],
      "inputs": {
        "report": { "source": "output", "node_id": "wait_suggest_a", "port": "report" }
      },
      "required": false
    },
    {
      "id": "reconciliation_cached",
      "step_type": "security_scan.reconciliation",
      "step_version": 1,
      "config": { "refresh": false, "source": null, "severity": null, "limit": 100 },
      "depends_on": ["assess_scan_a"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" }
      },
      "required": true
    },
    {
      "id": "reconciliation_refresh",
      "step_type": "security_scan.reconciliation",
      "step_version": 1,
      "config": { "refresh": true, "source": null, "severity": null, "limit": 100 },
      "depends_on": ["reconciliation_cached"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" }
      },
      "required": true
    },
    {
      "id": "reconciliation_reread",
      "step_type": "security_scan.reconciliation",
      "step_version": 1,
      "config": { "refresh": false, "source": null, "severity": null, "limit": 100 },
      "depends_on": ["reconciliation_refresh"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" },
        "expected_snapshot": { "source": "output", "node_id": "reconciliation_refresh", "port": "snapshot" }
      },
      "required": true
    },
    {
      "id": "reconciliation_filtered",
      "step_type": "security_scan.reconciliation",
      "step_version": 1,
      "config": { "refresh": false, "source": "dependabot", "severity": "high", "limit": 1 },
      "depends_on": ["reconciliation_refresh"],
      "inputs": {
        "run_id": { "source": "output", "node_id": "request_scan_a", "port": "run_id" }
      },
      "required": true
    },
    {
      "id": "integrity_after_scan_a",
      "step_type": "security_scan.fixture_integrity",
      "step_version": 1,
      "config": { "expected": "commit_a" },
      "depends_on": ["assess_scan_a"],
      "required": true
    },
    {
      "id": "create_scheduled_commit_b",
      "step_type": "security_scan.create_scheduled_commit",
      "step_version": 1,
      "config": { "scheduled_ref": "security-scan-e2e-scheduled" },
      "depends_on": ["integrity_after_scan_a"],
      "required": true
    },
    {
      "id": "wait_scheduled_scan_b",
      "step_type": "security_scan.wait_scheduled",
      "step_version": 1,
      "config": { "timeout_seconds": 180, "poll_interval_ms": 500 },
      "depends_on": ["create_scheduled_commit_b"],
      "inputs": {
        "repository": { "source": "output", "node_id": "preflight", "port": "repository" },
        "target_sha": { "source": "output", "node_id": "create_scheduled_commit_b", "port": "commit_b" }
      },
      "required": true
    },
    {
      "id": "assess_scheduled_scan_b",
      "step_type": "security_scan.assess_report",
      "step_version": 1,
      "config": {
        "mode": "scan",
        "seeded_paths": [
          "src/vulnerable.rs",
          "package.json",
          ".env.example",
          ".github/workflows/insecure.yml"
        ]
      },
      "depends_on": ["wait_scheduled_scan_b"],
      "inputs": {
        "report": { "source": "output", "node_id": "wait_scheduled_scan_b", "port": "report" }
      },
      "required": true
    },
    {
      "id": "list_final",
      "step_type": "security_scan.list",
      "step_version": 1,
      "config": {
        "repository": "iii-hq/security-scan-e2e-fixture",
        "status": "completed",
        "limit": 100,
        "expected_modes": ["scan", "suggest"],
        "expected_count": 3
      },
      "depends_on": [
        "assess_suggest_a",
        "reconciliation_reread",
        "reconciliation_filtered",
        "assess_scheduled_scan_b"
      ],
      "dependency_policy": "terminal",
      "required": true
    },
    {
      "id": "finalize",
      "step_type": "security_scan.finalize",
      "step_version": 1,
      "config": {},
      "depends_on": ["list_final"],
      "required": true
    }
  ],
  "criteria": [
    {
      "id": "scan_a_detection",
      "weight": 60,
      "producer_node_id": "assess_scan_a",
      "output_port": "assessment",
      "advisory": true
    },
    {
      "id": "suggest_a_quality",
      "weight": 20,
      "producer_node_id": "assess_suggest_a",
      "output_port": "assessment",
      "advisory": true
    },
    {
      "id": "scheduled_b_detection",
      "weight": 20,
      "producer_node_id": "assess_scheduled_scan_b",
      "output_port": "assessment",
      "advisory": true
    }
  ]
}
