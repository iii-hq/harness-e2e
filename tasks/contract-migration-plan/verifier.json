{
  "profile": "structured_artifact",
  "artifact_path": "migration-plan.json",
  "schema": {
    "type": "object", "additionalProperties": false,
    "required": ["objective", "evidence", "steps", "validation", "rollback"],
    "properties": {
      "objective": {"type": "string", "minLength": 20},
      "evidence": {
        "type": "array", "minItems": 2, "maxItems": 4,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "reason"],
          "properties": {
            "path": {"type": "string"},
            "reason": {"type": "string", "minLength": 15}
          }
        }
      },
      "steps": {
        "type": "array", "minItems": 4, "maxItems": 8,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "action", "completion_signal"],
          "properties": {
            "id": {"type": "string"}, "action": {"type": "string", "minLength": 15},
            "completion_signal": {"type": "string", "minLength": 10}
          }
        }
      },
      "validation": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
      "rollback": {"type": "string", "minLength": 20}
    }
  },
  "assertions": [
    {"id": "consumer_evidence", "dimension": "grounding", "pointer": "/evidence/0/path", "equals": "consumer/contract.json"},
    {"id": "producer_evidence", "dimension": "grounding", "pointer": "/evidence/1/path", "equals": "producer/contract.json"},
    {"id": "compatibility_first", "dimension": "grounding", "pointer": "/steps/0/id", "equals": "add-v1-v2-compatibility"},
    {"id": "dual_validation_before_cutover", "dimension": "grounding", "pointer": "/steps/1/id", "equals": "validate-dual-contract"},
    {"id": "consumer_migration_after_compatibility", "dimension": "grounding", "pointer": "/steps/2/id", "equals": "migrate-consumer"},
    {"id": "compatibility_retired_last", "dimension": "grounding", "pointer": "/steps/3/id", "equals": "retire-v1-compatibility"}
  ]
}
